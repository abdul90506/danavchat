{
  "name": "danav-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "danav-chat-db", "database_id": "c447b107-4c8f-4c47-acc3-5e00e2ff4912" }
  ],
  "durable_objects": { "bindings": [ { "name": "HUB", "class_name": "Hub" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Hub"] } ],
  "vars": {
    "GOOGLE_CLIENT_ID": "370332449699-p1mh478qjctcs7v5lddkntsotk5c981v.apps.googleusercontent.com",
    "CLOUDINARY_CLOUD": "a18ixxoo",
    "TURN_URL": "free.expressturn.com:3478"
  }
}
